+gboolean
+fu_dell_dock_ec_verify_serial(FuDellDockEc *self, const gchar *expected, GError **error)
+{
+	g_autoptr(FuDeviceLocker) locker = NULL;
+	const gchar *actual;
+
+	if (expected == NULL || expected[0] == '\0') {
+		g_set_error_literal(error,
+				    FWUPD_ERROR,
+				    FWUPD_ERROR_NOT_SUPPORTED,
+				    "expected Dell dock serial is empty");
+		return FALSE;
+	}
+	locker = fu_device_locker_new(FU_DEVICE(self), error);
+	if (locker == NULL)
+		return FALSE;
+	if (!fu_dell_dock_ec_get_dock_data(self, error))
+		return FALSE;
+	actual = fu_device_get_serial(FU_DEVICE(self));
+	if (actual == NULL || actual[0] == '\0') {
+		g_set_error_literal(error,
+				    FWUPD_ERROR,
+				    FWUPD_ERROR_NOT_SUPPORTED,
+				    "Dell dock serial is unavailable before write");
+		return FALSE;
+	}
+	if (g_strcmp0(actual, expected) != 0) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_SUPPORTED,
+			    "Dell dock serial changed before write: expected %s, got %s",
+			    expected,
+			    actual);
+		return FALSE;
+	}
+	return TRUE;
+}
